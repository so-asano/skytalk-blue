# Database connection
DATABASE_URL=postgresql://skytalkblue:skytalkblue@localhost:5432/skytalkblue

# API secret (must match apps/web/.env.local NEXT_PUBLIC_API_SECRET)
API_SECRET=your-secret-key

# Cloudflare R2 (optional - falls back to PDS if not configured)
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key
# R2_SECRET_ACCESS_KEY=your-secret-key
# R2_BUCKET_NAME=skychannel-images
# R2_PUBLIC_URL=https://images.example.com
