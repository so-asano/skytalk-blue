{
  "lexicon": 1,
  "id": "blue.skytalk.talk.permissionSet",
  "defs": {
    "main": {
      "type": "permission-set",
      "title": "SkyTalk.Blue",
      "detail": "Create threads and comments, reactions, and upload media",
      "detail:lang": {
        "en": "Create threads and comments, add reactions, upload media",
        "ja-JP": "スレッドとコメントの作成、リアクションの追加、メディアのアップロード"
      },
      "permissions": [
        {
          "type": "permission",
          "resource": "repo",
          "collection": [
            "blue.skytalk.talk.thread",
            "blue.skytalk.talk.comment",
            "blue.skytalk.talk.reaction"
          ]
        },
        {
          "type": "permission",
          "resource": "blob"
        }
      ]
    }
  }
}
